{
    "name": "openjobspec/sdk",
    "description": "PHP SDK for Open Job Spec (OJS) — the open standard for background job processing",
    "version": "0.4.0",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["background-jobs", "job-queue", "task-queue", "openjobspec", "ojs"],
    "homepage": "https://openjobspec.org",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "OpenJobSpec\\": "src/",
            "OpenJobSpec\\Testing\\": "src/Testing/"
        },
        "classmap": ["src/"]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenJobSpec\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse src tests --level=5 --memory-limit=1G",
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --coverage-text --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
